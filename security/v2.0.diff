+    The device accepts -44..48 (UTC-11:00 to UTC+12:00 in steps of 15 minutes).
+
+    Formats:
+    - Germany (CET): "4" -> "UTC+01:00"
+    - India: "22" -> "UTC+05:30"
+    - Newfoundland: "-14" -> "UTC-03:30"
+    """
+    try:
+        quarters = int(str(value).strip())
+    except ValueError:
+        return None
+    if not -44 <= quarters <= 48:
