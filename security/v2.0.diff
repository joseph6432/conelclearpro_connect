+def _pa_group_keys(idx: int) -> list[str]:
+    """Return the keys of leak-protection profile `idx` (1-8), controlled by getPA<idx>."""
+    return [
+        f"getPA{idx}",
+        f"getPV{idx}",
+        f"getPT{idx}",
+        f"getPF{idx}",
+        f"getPN{idx}",
+        f"getPM{idx}",
+        f"getPW{idx}",
+        f"getPB{idx}",
+        f"getPR{idx}",
+    ]
+
